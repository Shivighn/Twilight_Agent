# ─────────────────────────────────────────────
#  Supabase (same project as FleetZen)
# ─────────────────────────────────────────────
# NEVER put real keys in this file — it is committed to git.
# Real values go in .env (gitignored).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ─────────────────────────────────────────────
#  WhatsApp (JavaScript service)
# ─────────────────────────────────────────────
WA_MONITORED_CHATS=Bills Group

# URL of the Python agent service (same machine = localhost)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TIMEOUT_MS=120000

# ─────────────────────────────────────────────
#  LLM providers (Python agent service)
# ─────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─────────────────────────────────────────────
#  Company Website REST API (Python agent service)
# ─────────────────────────────────────────────
WEBSITE_API_BASE_URL=https://yourcompany.com/api
WEBSITE_API_KEY=your_api_key_here
WEBSITE_BILL_ENDPOINT=/bills

# ─────────────────────────────────────────────
#  Fleet Issue Auto-Assignment & WhatsApp Escalation Agent
#  See "inspection tagging agent.txt" (repo root) for the spec.
#  Runs inside this same gateway process (node-cron) and reuses the single
#  WhatsApp connection above — it does not open a second session.
# ─────────────────────────────────────────────
# Off by default. Leave false until WHATSAPP_GROUP_ID and the FM ids below
# are filled in with real values — otherwise it just runs and skips sending.
FLEET_ISSUE_AGENT_ENABLED=false

AGENT_TIMEZONE=Asia/Kolkata
AGENT_RUN_TIME=10:00

TRIP_LOOKBACK_DAYS=10
FM_ESCALATION_DAYS=2
SENIOR_ESCALATION_DAYS=5

# Comma-separated issues.status values this agent will process.
FLEET_ISSUE_OPEN_STATUSES=Open,In Progress,Reopened

# Must match services_incharge.fleet_manager_id values exactly.
ANUDEEP_FM_ID=anudeep_mukkoti
VENKY_FM_ID=venkyfi

# Plain display names for now (used as literal "@Name" text, NOT real
# WhatsApp mentions/JIDs) — swap for real WhatsApp IDs later.
UDAY_WHATSAPP_ID=Uday
SIVA_WHATSAPP_ID=Siva
ANIL_WHATSAPP_ID=Anil

# WhatsApp group JID to post FM-assignment + escalation messages into.
WHATSAPP_GROUP_ID=

# ─────────────────────────────────────────────
#  Terminal 44 Daily History Report
#  Posts yesterday's (IST) departed-vehicle history from Terminal 44 as a
#  CSV to WhatsApp, once a day. Runs inside this same gateway process
#  (node-cron) and reuses the single WhatsApp connection above.
# ─────────────────────────────────────────────
# Off by default — same reasoning as FLEET_ISSUE_AGENT_ENABLED above.
TERMINAL44_REPORT_ENABLED=false

TERMINAL44_RUN_TIME=02:00
TERMINAL44_API_BASE_URL=https://be.fleetzen.co.in

# WhatsApp group name (or JID) to post the CSV document into.
TERMINAL44_WHATSAPP_GROUP_ID=Agent Test

# ─────────────────────────────────────────────
#  MG Fuel Savings Daily Status Post
#  Posts a daily MG Fuel Savings status (anomaly count, or total savings if
#  none) to WhatsApp at 10 AM; a second run at 4 PM only actually sends if
#  the 10 AM run found >=1 anomaly (see mgFuelSavings/morningResultStore.js
#  — persisted to disk so this survives a restart in between). be.fleetzen.co.in
#  requires a real logged-in session for these endpoints (HttpOnly cookie +
#  CSRF token), not an API key — see src/mgFuelSavings/authClient.js. NEVER
#  put real credentials in this file.
# ─────────────────────────────────────────────
# Off by default — same reasoning as FLEET_ISSUE_AGENT_ENABLED above.
MG_FUEL_SAVINGS_ENABLED=false

MG_FUEL_SAVINGS_RUN_TIME=10:00
MG_FUEL_SAVINGS_AFTERNOON_RUN_TIME=16:00
MG_FUEL_SAVINGS_API_BASE_URL=https://be.fleetzen.co.in

# Dedicated automation account (real login, not an API key). Real values go
# in .env only.
MG_FUEL_SAVINGS_EMAIL=automation@yourcompany.com
MG_FUEL_SAVINGS_PASSWORD=your_password_here

# WhatsApp group name (or JID) to post the status message into.
MG_FUEL_SAVINGS_WHATSAPP_GROUP_ID=Agent Test

# Anomaly-message tags — real phone numbers so these render as real
# WhatsApp mentions, not inert "@Name" text. Anil reuses ANIL_WHATSAPP_ID
# above (fleetIssues' escalation contact, same person).
BALAJI_WHATSAPP_ID=
LIKHITH_WHATSAPP_ID=

# ─────────────────────────────────────────────
#  Shared
# ─────────────────────────────────────────────
STORAGE_DIR=./storage
LOG_LEVEL=info
